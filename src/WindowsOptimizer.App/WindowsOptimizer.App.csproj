<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>WindowsOptimizer</AssemblyName>
    <RootNamespace>WindowsOptimizer.App</RootNamespace>
    <Product>Windows Optimizer</Product>
    <!-- Local builds only; the pipeline overrides it with <version.txt>.<run number>. -->
    <Version>0.2.0</Version>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts, so App.xaml isn't the entry point. -->
    <StartupObject>WindowsOptimizer.App.Program</StartupObject>
    <!-- "asInvoker": Release builds ask for administrator rights themselves at start (see Program.cs).
         Debug builds don't, so the app can be started from the IDE and in screenshots without a UAC prompt. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The greyhound. Drawn in tools/app-icon/greyhound.xaml and rendered by tools/Build-Icon.ps1. WPF windows,
         the taskbar and the Start menu shortcut all use the exe's icon. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer and automatic updates. The pipeline's vpk tool must be the same version. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsOptimizer.Core\WindowsOptimizer.Core.csproj" />
  </ItemGroup>

</Project>
