<Window x:Class="WindowsOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:WindowsOptimizer.Core;assembly=WindowsOptimizer.Core"
        xmlns:vm="clr-namespace:WindowsOptimizer.App.ViewModels"
        Title="Windows Optimizer" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13" UseLayoutRounding="True"
        Loaded="OnLoaded">

    <Window.Resources>

        <!-- A list of tweak rows drawn as one card. The last row's divider is pushed under the border. -->
        <Style x:Key="CardList" TargetType="ItemsControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <Grid ClipToBounds="True">
                                <ItemsPresenter Margin="0,0,0,-1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Card" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One tweak, as a single row. The left edge is the state gauge; the chevron opens the setup sheet. -->
        <DataTemplate DataType="{x:Type vm:TweakViewModel}">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Applied">
                                        <Setter Property="Background" Value="{DynamicResource AppliedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Partial">
                                        <Setter Property="Background" Value="{DynamicResource PartialBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid Grid.Column="1" Margin="12,7,8,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <WrapPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Margin="0,1,8,1"/>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource DangerTextBrush}"
                                        Visibility="{Binding IsHighRisk, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="High risk" Foreground="{DynamicResource DangerTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource PartialTextBrush}"
                                        Visibility="{Binding IsMediumRisk, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Medium risk" Foreground="{DynamicResource PartialTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource AppliedTextBrush}"
                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Recommended" Foreground="{DynamicResource AppliedTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource PartialTextBrush}"
                                        Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Experimental" Foreground="{DynamicResource PartialTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource PartialTextBrush}"
                                        Visibility="{Binding IsSlow, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Can take a few minutes" Foreground="{DynamicResource PartialTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource InfoTextBrush}"
                                        Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Admin" Foreground="{DynamicResource InfoTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource PartialTextBrush}"
                                        Visibility="{Binding RestartsExplorer, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Restarts Explorer" Foreground="{DynamicResource PartialTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource PartialTextBrush}"
                                        Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Restart PC" Foreground="{DynamicResource PartialTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource PartialTextBrush}"
                                        Visibility="{Binding IsPartial, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource ChipText}" Text="Partly on" Foreground="{DynamicResource PartialTextBrush}"/>
                                </Border>
                            </WrapPanel>

                            <!-- One line; the whole text is in the tooltip and in the sheet below. -->
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MetaText}" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,1,0,0"/>


                            <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                       Margin="0,3,0,0" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource PartialTextBrush}"
                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Already on before this app: it kept no backup, so the switch can't turn it off. -->
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource MetaText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       ToolTip="It was already on before this app, so there is no backup to switch it off here."
                                       Visibility="{Binding NoBackupNote, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AppliedTextBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="{Binding Name}"/>
                            <Button Content="{Binding ApplyLabel}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding CanRun}"
                                    Visibility="{Binding ShowRun, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="{Binding Name, StringFormat=Run: {0}}"/>
                            <Button Content="Remove this game" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                    Command="{Binding RemoveGameCommand}"
                                    Visibility="{Binding IsGameTweak, Converter={StaticResource BoolToVisibility}}"/>
                            <ToggleButton Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Margin="6,0,0,0"
                                          AutomationProperties.Name="{Binding Name, StringFormat=See what changes: {0}}"
                                          Visibility="{Binding IsUnavailable, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <Border Margin="0,8,0,2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="12,8,12,8" LineHeight="18"/>
                                    <Grid Background="{DynamicResource SheetHeadBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Item" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,5"/>
                                        <TextBlock Grid.Column="1" Text="Now" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,5"/>
                                        <TextBlock Grid.Column="2" Text="After" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,5"/>
                                    </Grid>
                                    <TextBlock Text="This tweak runs an action; there are no values to list."
                                               Style="{StaticResource MetaText}" Margin="12,8"
                                               Visibility="{Binding PreviewEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding Preview}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type core:PreviewLine}">
                                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="170"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="12,6">
                                                            <TextBlock Text="{Binding Item}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DataText}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Current}" Style="{StaticResource DataText}"
                                                                   Foreground="{DynamicResource MutedBrush}" Margin="12,6"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Target}" Style="{StaticResource DataText}"
                                                                   FontWeight="SemiBold" Margin="12,6"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" BorderThickness="0"
                                         Foreground="{DynamicResource InkBrush}" Background="{DynamicResource LineBrush}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppliedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- An installed AI app, with a Remove button. -->
        <DataTemplate DataType="{x:Type vm:AiAppViewModel}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="5" Margin="0,0,0,6" Padding="16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource DisplayFont}" FontSize="16"/>
                        <TextBlock Text="{Binding PackageName}" Style="{StaticResource DataText}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Remove" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Remove: {0}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One line of the health check. The left edge says how serious it is. -->
        <DataTemplate DataType="{x:Type vm:HealthItemViewModel}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="5" Margin="0,0,0,6" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Good">
                                        <Setter Property="Background" Value="{DynamicResource AppliedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Attention">
                                        <Setter Property="Background" Value="{DynamicResource PartialBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,10,16,10">
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LevelText}" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Good">
                                            <Setter Property="Foreground" Value="{DynamicResource AppliedTextBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Attention">
                                            <Setter Property="Foreground" Value="{DynamicResource PartialTextBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A saved measurement. -->
        <DataTemplate DataType="{x:Type vm:SnapshotViewModel}">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="15"/>
                        <TextBlock Text="{Binding When}" Style="{StaticResource MetaText}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource DataText}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Remove" Style="{StaticResource LinkButton}" VerticalAlignment="Top"
                            Command="{Binding RemoveCommand}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One row of the before/after table. -->
        <DataTemplate DataType="{x:Type core:ComparisonRow}">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Metric}" Margin="12,9" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource DataText}" Foreground="{DynamicResource MutedBrush}" Margin="12,9"/>
                    <TextBlock Grid.Column="2" Text="{Binding After}" Style="{StaticResource DataText}" FontWeight="SemiBold" Margin="12,9"/>
                    <TextBlock Grid.Column="3" Text="{Binding Change}" Margin="12,9">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Verdict}" Value="Better">
                                        <Setter Property="Foreground" Value="{DynamicResource AppliedTextBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="Worse">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- The root paints the page colour itself so screenshots of the content (which skip the window background) match the real window. -->
    <Grid Background="{DynamicResource PaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="14,12,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Windows Optimizer" FontFamily="{StaticResource DisplayFont}" FontSize="17" Margin="8,0,0,8"/>

            <ListBox Grid.Row="1" ItemsSource="{Binding CategoriesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource CategoryItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Categories">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Margin="8,10,0,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                            <Style.Triggers>
                                                <!-- "All tweaks" sits above the first heading and has none of its own. -->
                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="11.5" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Restore point, update check, refresh and theme live in one panel instead of taking up the sidebar. -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Button x:Name="SettingsButton" Style="{StaticResource SecondaryButton}" Click="OnSettingsClick"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Width="236" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Restore point" FontWeight="SemiBold"/>
                                    <TextBlock Text="Before the first tweak of each session" Style="{StaticResource MetaText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                              IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}"
                                              AutomationProperties.Name="Create a restore point before the first tweak"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Check for updates" FontWeight="SemiBold"/>
                                    <TextBlock Text="Asks GitHub for the latest release when the app starts. Nothing else is sent."
                                               Style="{StaticResource MetaText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                              IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                                              AutomationProperties.Name="Check for updates on start"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <Button Content="Refresh states" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                            Command="{Binding RefreshCommand}" Click="OnSettingsActionClick"/>
                                    <Button Content="{Binding ThemeLabel}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                            Margin="0,4,0,0" Command="{Binding CycleThemeCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="18,12,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Background="{DynamicResource BannerBgBrush}" BorderBrush="{DynamicResource BannerLineBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="12,6" Margin="0,0,0,8"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Content="{Binding UpdateButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding OpenUpdateCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Dismiss" Style="{StaticResource SecondaryButton}" Command="{Binding DismissUpdateCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource BannerBgBrush}" BorderBrush="{DynamicResource BannerLineBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="12,6" Margin="0,0,0,8"
                        Visibility="{Binding ExplorerRestartNeeded, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Some of your changes only show after File Explorer restarts." TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Content="Restart Explorer" Style="{StaticResource PrimaryButton}" Command="{Binding RestartExplorerCommand}" Margin="0,0,8,0"/>
                            <Button Content="Later" Style="{StaticResource SecondaryButton}" Command="{Binding DismissExplorerCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource BannerBgBrush}" BorderBrush="{DynamicResource BannerLineBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="12,6" Margin="0,0,0,8"
                        Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="The app is not running as administrator. Tweaks that change the system will fail. Close it and open it again with &quot;Run as administrator&quot;."/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Title, what the page is for, and how many tweaks are on: one line. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Selected.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="22"/>
                    <TextBlock Text="{Binding Selected.Blurb}" Style="{StaticResource MetaText}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.Blurb}"
                               MaxWidth="560" Margin="12,0,0,3" VerticalAlignment="Bottom"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Selected.SummaryText}" Style="{StaticResource MetaText}"
                           VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                <Button Grid.Column="2" Content="Add a game…" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                        Command="{Binding AddGameCommand}"
                        Visibility="{Binding Selected.IsGames, Converter={StaticResource BoolToVisibility}}"/>
                <Button Grid.Column="2" Content="Check again" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                        Command="{Binding Health.RunCommand}" IsEnabled="{Binding Health.CanRun}"
                        Visibility="{Binding Selected.IsHealth, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- Tweaks (every category, and "Your games") -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                          Visibility="{Binding Selected.ShowsTweaks, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No games yet. Press &quot;Add a game…&quot; and pick the game's .exe; you then choose what to change for it, one setting at a time."
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}"
                               Visibility="{Binding Selected.ShowsEmptyGames, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Selected.FlatTweaks}" Style="{StaticResource CardList}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Selected.GroupedTweaks}" Margin="0,0,0,12">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel Margin="0,0,0,10">
                                                        <StackPanel Orientation="Horizontal" Margin="2,4,0,4">
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="13.5"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat={}{0} tweaks}" Style="{StaticResource MetaText}" Margin="8,0,0,0"
                                                                       VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                                BorderThickness="1" CornerRadius="5">
                                                            <Grid ClipToBounds="True">
                                                                <ItemsPresenter Margin="0,0,0,-1"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>

                    <!-- AI apps that came with Windows or Microsoft 365 -->
                    <StackPanel Margin="0,8,0,16" Visibility="{Binding Selected.ShowsAiApps, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Installed AI apps" FontFamily="{StaticResource DisplayFont}" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock Text="No AI apps from this list are installed for your account." Style="{StaticResource MetaText}"
                                   Visibility="{Binding Selected.NoAiApps, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding Selected.AiApps}"/>
                    </StackPanel>

                    <!-- Tweaks that don't apply here, with the reason -->
                    <StackPanel Margin="0,8,0,16" Visibility="{Binding Selected.HasUnavailable, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Not available on this PC" FontFamily="{StaticResource DisplayFont}" FontSize="16" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Selected.Unavailable}" Style="{StaticResource CardList}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PC health check -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                          Visibility="{Binding Selected.IsHealth, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Health.Summary}" FontFamily="{StaticResource DisplayFont}" FontSize="17" Margin="0,0,0,12"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12" BorderThickness="0"
                                 Foreground="{DynamicResource InkBrush}" Background="{DynamicResource LineBrush}"
                                 Visibility="{Binding Health.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Health.Items}" Margin="0,0,0,16"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Before and after -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                          Visibility="{Binding Selected.IsMeasure, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,0,0,16" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                               Text="A snapshot measures what tweaks can really change: the load Windows puts on the PC while it sits idle, how many programs start with it, and how long the last boot took. It does not measure frame rate; for that, record a game with a frame-time tool such as CapFrameX or PresentMon, before and after."/>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Take a snapshot" FontFamily="{StaticResource DisplayFont}" FontSize="16"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Measure.Label, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="Snapshot name"/>
                                <Button Grid.Column="1" Content="Take snapshot (10 s)" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                        Command="{Binding Measure.TakeCommand}" IsEnabled="{Binding Measure.CanTake}"/>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Measure.Progress, Mode=OneWay}" Height="4" Margin="0,12,0,0" BorderThickness="0"
                                         Foreground="{DynamicResource InkBrush}" Background="{DynamicResource LineBrush}"
                                         Visibility="{Binding Measure.IsCapturing, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding Measure.Status}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Your snapshots" FontFamily="{StaticResource DisplayFont}" FontSize="16" Margin="0,22,0,4"/>
                    <TextBlock Text="None yet." Style="{StaticResource MetaText}"
                               Visibility="{Binding Measure.HasSnapshots, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Measure.Snapshots}"/>

                    <TextBlock Text="Compare" FontFamily="{StaticResource DisplayFont}" FontSize="16" Margin="0,22,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Before" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Measure.Snapshots}" SelectedItem="{Binding Measure.Before, Mode=TwoWay}"
                                  AutomationProperties.Name="Snapshot taken before" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="After" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Measure.Snapshots}" SelectedItem="{Binding Measure.After, Mode=TwoWay}"
                                  AutomationProperties.Name="Snapshot taken after"/>
                    </Grid>
                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding Measure.CanCompare, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Background="{DynamicResource SheetHeadBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Measure" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,7"/>
                                <TextBlock Grid.Column="1" Text="Before" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,7"/>
                                <TextBlock Grid.Column="2" Text="After" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,7"/>
                                <TextBlock Grid.Column="3" Text="Change" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,7"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Measure.Rows}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Differences smaller than normal measurement noise show as &quot;no real change&quot;. For the cleanest comparison, take both snapshots right after a restart, with nothing else open."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Log -->
        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="150"
                 FontFamily="{StaticResource DataFont}" FontSize="12" Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource InkBrush}"
                 BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8"
                 VerticalScrollBarVisibility="Auto" TextChanged="OnLogChanged"
                 Visibility="{Binding ShowLog, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="Activity log"/>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LastMessage}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Open logs folder" Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource LinkButton}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="2" Content="Log" Style="{StaticResource LinkToggle}"
                              IsChecked="{Binding ShowLog, Mode=TwoWay}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
