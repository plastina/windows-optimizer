<Window x:Class="WindowsOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:WindowsOptimizer.Core;assembly=WindowsOptimizer.Core"
        xmlns:vm="clr-namespace:WindowsOptimizer.App.ViewModels"
        Title="Windows Optimizer" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        Background="{StaticResource PaperBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13" UseLayoutRounding="True"
        Loaded="OnLoaded">

    <Window.Resources>

        <!-- One tweak. The left edge is the state gauge; "See what changes" opens a setup sheet. -->
        <DataTemplate DataType="{x:Type vm:TweakViewModel}">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource LineBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Applied">
                                        <Setter Property="Background" Value="{StaticResource AppliedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Partial">
                                        <Setter Property="Background" Value="{StaticResource PartialBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,16,20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="17" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding RiskText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Risk}" Value="High">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                        <Setter Property="Foreground" Value="{StaticResource PartialTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0"
                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Applied">
                                                        <Setter Property="Foreground" Value="{StaticResource AppliedTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                        <Setter Property="Foreground" Value="{StaticResource PartialTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Needs a PC restart" Style="{StaticResource MetaText}" Margin="16,0,0,0"
                                               Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Undo" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndoNow}"
                                        Visibility="{Binding ShowUndo, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Undo: {0}}"/>
                                <Button Content="{Binding ApplyLabel}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Apply: {0}}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Margin="0,10,0,0" LineHeight="19"/>

                        <TextBlock Text="It was already like this before the app; there is no backup to undo."
                                   Style="{StaticResource MetaText}" Margin="0,8,0,0"
                                   Visibility="{Binding NoBackupNote, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Margin="0,8,0,0" Foreground="{StaticResource PartialTextBrush}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>

                        <ToggleButton Content="See what changes" Style="{StaticResource LinkToggle}" HorizontalAlignment="Left"
                                      Margin="-2,10,0,0" IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>

                        <Border Margin="0,8,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Background="{StaticResource SheetHeadBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Item" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,7"/>
                                    <TextBlock Grid.Column="1" Text="Now" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,7"/>
                                    <TextBlock Grid.Column="2" Text="After" Style="{StaticResource MetaText}" FontWeight="SemiBold" Margin="12,7"/>
                                </Grid>
                                <TextBlock Text="This tweak runs an action; there are no values to list."
                                           Style="{StaticResource MetaText}" Margin="12,10"
                                           Visibility="{Binding PreviewEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Preview}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:PreviewLine}">
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="170"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="12,8">
                                                        <TextBlock Text="{Binding Item}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource DataText}"
                                                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Current}" Style="{StaticResource DataText}"
                                                               Foreground="{StaticResource MutedBrush}" Margin="12,8"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Target}" Style="{StaticResource DataText}"
                                                               FontWeight="SemiBold" Margin="12,8"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" BorderThickness="0"
                                     Foreground="{StaticResource InkBrush}" Background="{StaticResource LineBrush}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AppliedTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="20,24,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,0,0,20">
                <TextBlock Text="Windows Optimizer" FontFamily="{StaticResource DisplayFont}" FontSize="22"/>
                <TextBlock Text="Each tweak on its own, with undo." Style="{StaticResource MetaText}" Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource CategoryItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Categories">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="13" Opacity="0.7" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="10,12,0,0">
                <CheckBox IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,12">
                    <TextBlock Text="Create a restore point before the first tweak" TextWrapping="Wrap"/>
                </CheckBox>
                <Button Content="Refresh states" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="12,24,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BannerBgBrush}" BorderBrush="{StaticResource BannerLineBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap"
                           Text="The app is not running as administrator. Tweaks that change the system will fail. Close it and open it again with &quot;Run as administrator&quot;."/>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <TextBlock Text="{Binding Selected.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="30"/>
                <TextBlock Text="{Binding Selected.Blurb}" Foreground="{StaticResource MutedBrush}" FontSize="14"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Selected.Tweaks}" Margin="0,0,0,16"/>
            </ScrollViewer>
        </Grid>

        <!-- Log -->
        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="150"
                 FontFamily="{StaticResource DataFont}" FontSize="12" Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8"
                 VerticalScrollBarVisibility="Auto" TextChanged="OnLogChanged"
                 Visibility="{Binding ShowLog, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="Activity log"/>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LastMessage}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Open logs folder" Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource LinkButton}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="2" Content="Log" Style="{StaticResource LinkToggle}"
                              IsChecked="{Binding ShowLog, Mode=TwoWay}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
